# Puerto del backend
PORT=5000

# Conexión a MongoDB (obligatoria para iniciar el servidor)
MONGODB_URI=mongodb://127.0.0.1:27017/urbi

# Área máxima de análisis geográfico, en km² (por defecto 2)
OSM_MAX_AREA_KM2=2

# Endpoints de Overpass separados por comas. El primero es el principal.
# Solo añade alternativas si asumes su política de uso.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter
